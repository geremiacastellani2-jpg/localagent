# Copia questo file in .env e compila i valori.

# --- Cloud: OpenRouter (OpenAI-compatibile) ---
# Ottieni la chiave su https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CLOUD_MODEL=anthropic/claude-3.5-sonnet
CLOUD_VISION_MODEL=anthropic/claude-3.5-sonnet

# --- Locale: Ollama (OpenAI-compatibile) ---
# Installa Ollama (https://ollama.com) e scarica i modelli:
#   ollama pull qwen2.5
#   ollama pull llama3.2-vision
OLLAMA_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5
LOCAL_VISION_MODEL=llama3.2-vision

# --- Routing ---
# Dove mandare la chat: cloud | local | auto  (auto = cloud se c'è la chiave)
DEFAULT_TIER=auto
# Dove mandare la vista (VLM): cloud | local | auto
VISION_TIER=auto

# --- Server ---
HOST=127.0.0.1
PORT=8765

# --- Storage ---
# DB_PATH=./data/maggiordomo.db
