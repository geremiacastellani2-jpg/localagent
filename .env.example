# Copia questo file in .env e compila i valori.

# --- Cloud: OpenRouter (OpenAI-compatibile) ---
# Ottieni la chiave su https://openrouter.ai/keys (serve anche per i modelli gratuiti)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Solo modelli a costo zero sul cloud (il locale è sempre gratuito). La rosa dei
# gratuiti viene letta dal catalogo di OpenRouter e ruota da sola sui 429.
FREE_ONLY=true
# "auto" = scegli dalla rosa; oppure metti un id ":free" per averlo come primo
# (es. google/gemma-4-31b-it:free). Con FREE_ONLY=false puoi mettere un modello a pagamento.
CLOUD_MODEL=auto
CLOUD_VISION_MODEL=auto

# --- Locale: Ollama (OpenAI-compatibile) ---
# Installa Ollama (https://ollama.com) e scarica i modelli:
#   ollama pull qwen2.5
#   ollama pull llama3.2-vision
OLLAMA_BASE_URL=http://localhost:11434/v1
# Consigli: gemma4 (italiano migliore) o gpt-oss:20b (tool-calling migliore)
LOCAL_MODEL=qwen2.5
LOCAL_VISION_MODEL=llama3.2-vision
# Embedding per la memoria semantica (Fase 3):  ollama pull nomic-embed-text
EMBED_MODEL=nomic-embed-text

# --- Routing ---
# Dove mandare la chat: cloud | local | auto
#   auto (ibrido) = LOCALE se Ollama è attivo (privato, gratuito), cloud altrimenti.
#   Puoi comunque forzare locale/cloud per singolo messaggio dal menu nella chat.
DEFAULT_TIER=auto
# Dove mandare la vista (VLM): cloud | local | auto
#   auto = CLOUD se c'è la chiave (qualità migliore), locale altrimenti.
#   Se un tier fallisce, la vista riprova automaticamente sull'altro.
VISION_TIER=auto

# --- Calendario: CalDAV (facoltativo; senza, il calendario resta solo locale) ---
# iCloud:  URL https://caldav.icloud.com/ , USERNAME = Apple ID,
#          PASSWORD = password specifica per app (appleid.apple.com → Sicurezza).
# Google:  URL https://apidata.googleusercontent.com/caldav/v2/<id>/user , app password.
# Fastmail/Radicale: l'URL CalDAV del tuo provider.
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
# Nome del calendario da usare (vuoto = il primo disponibile)
CALDAV_CALENDAR=

# --- Email: IMAP/SMTP (Fase 4; facoltativo) ---
# Gmail: attiva la verifica in 2 passaggi e crea una "password per le app"
#        (myaccount.google.com → Sicurezza) da usare come EMAIL_PASSWORD.
EMAIL_ADDRESS=
EMAIL_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# --- Messaggi: Matrix / WhatsApp (Fase 5; facoltativo) ---
# Vedi docs/whatsapp.md per avviare Synapse + mautrix-whatsapp e ottenere il token.
MATRIX_HOMESERVER=
MATRIX_USER=
MATRIX_TOKEN=
# In alternativa al token puoi usare la password (sconsigliato):
MATRIX_PASSWORD=
MATRIX_DEVICE_ID=MAGGIORDOMO

# --- Vista live: descrizione continua della scena col VLM ---
LIVE_DESCRIBE_ENABLED=true
# ogni quanti secondi ridescrivere la scena (0 = disattivo); prima se la scena cambia.
# In locale (llama3.2-vision) ogni descrizione costa qualche secondo di GPU/CPU;
# in cloud costa token: alza il valore se vuoi risparmiare.
LIVE_DESCRIBE_SECONDS=20

# --- Proattività (Fase 6) ---
# Scheduler: promemoria che scattano + rassegna del mattino
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60
BRIEF_HOUR=8
# Secondi di assenza oltre i quali un volto che riappare conta come "arrivo"
PRESENCE_ARRIVAL_GAP=120

# --- Server ---
HOST=127.0.0.1
PORT=8765

# --- Storage ---
# DB_PATH=./data/maggiordomo.db
